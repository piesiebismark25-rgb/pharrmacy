# ============================================================
#  I.K HOLINESS HOME CARE SERVICES
#  Apache .htaccess — InfinityFree Production Config
#  Domain: https://ikclinic.page.gd
#
#  Architecture:
#    Root index.php  → frontend/public/index.php (front controller)
#    All requests    → funnelled through the PHP router
#    Static assets   → served directly (CSS, JS, images, fonts)
# ============================================================

# ── 1. Engine On ────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set the base to the document root
    RewriteBase /

    # ── 2. Block direct access to sensitive directories ──────
    # Deny access to backend source, .env, .git
    RewriteRule ^\.env$                  - [F,L]
    RewriteRule ^\.env\..*$              - [F,L]
    RewriteRule ^\.git(/.*)?$            - [F,L]
    RewriteRule ^backend/(.*)$           - [F,L]
    RewriteRule ^frontend/views/(.*)$    - [F,L]

    # ── 3. Let real static files pass through unchanged ──────
    # (CSS, JS, images, fonts, favicon, robots.txt, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Let real directories (e.g. frontend/public/assets/) pass
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ── 4. Route every other request to the front controller ─
    # All clean URLs → frontend/public/index.php
    RewriteRule ^(.*)$ frontend/public/index.php [QSA,L]

</IfModule>

# ── 5. Deny directory listing everywhere ────────────────────
Options -Indexes

# ── 6. Deny direct access to sensitive file types ───────────
<FilesMatch "\.(env|log|sql|sh|bak|gitignore|json|lock|md|xlsx)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to composer files
<FilesMatch "^(composer\.(json|lock)|autoload\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── 7. PHP settings (InfinityFree compatible) ────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize  16M
    php_value post_max_size        16M
    php_value max_execution_time   60
    php_value memory_limit         128M
</IfModule>

# ── 8. Charset & MIME types ──────────────────────────────────
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css               .css
    AddType image/svg+xml          .svg
    AddType image/webp             .webp
    AddType font/woff2             .woff2
    AddType font/woff              .woff
</IfModule>

# ── 9. Browser caching for static assets ────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType image/png                 "access plus 1 month"
    ExpiresByType image/jpeg                "access plus 1 month"
    ExpiresByType image/gif                 "access plus 1 month"
    ExpiresByType image/svg+xml             "access plus 1 month"
    ExpiresByType image/webp                "access plus 1 month"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ── 10. Gzip compression ────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ── 11. Security headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 12. Custom error pages (optional) ───────────────────────
# ErrorDocument 404 /frontend/public/index.php
# ErrorDocument 403 /frontend/public/index.php
# ErrorDocument 500 /frontend/public/index.php